# Optional. Without these, the public storefront uses original local demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Explicit canonical URL when deploying. Defaults to localhost in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only after Supabase confirmation/recovery email and redirects are tested.
AUTH_EMAIL_ENABLED=false
